# Kflower 环境配置示例
# 复制此文件为 .env 并填入实际值

# ============ 应用配置 ============
APP_NAME=Kflower 企业智能管理低代码平台
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8898

# ============ 数据库（开发用SQLite，生产用MySQL/PG）============
DATABASE_URL=sqlite+aiosqlite:///D:/kflower/kflower-data/kflower.db

# 生产环境示例：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kflower
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/kflower

# ============ AI大模型配置 ============
# SiliconFlow（推荐，免费额度）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B

# DeepSeek（备选）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 通义千问（备选）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-max
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认AI提供商：siliconflow / deepseek / qwen
AI_PROVIDER=siliconflow

# ============ Embedding配置 ============
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v2

# ============ 向量数据库（可选）============
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333

# ============ Redis（可选）============
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ============ JWT认证 ============
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ CORS ============
CORS_ORIGINS=["*"]
